+          url: server.url,
+          oauth: false,
+          timeout: new ConfigMCP.Timeout({ startup: 400 }),
+        }),
+        import.meta.dir,
+      ).pipe(Effect.exit)
+      console.info("MCP late success receipt", { firstStatus, elapsed: performance.now() - started, attempts })
