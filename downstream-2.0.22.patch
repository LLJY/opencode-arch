+      const provider = Provider.Info.make({
+        ...Provider.Info.empty(Provider.ID.make("timeout-fixture")),
+        activation: "enabled",
+        package: "@opencode/ai/providers/openai/chat",
+        settings: {
+          baseURL: server.url.href,
+          ...(mode === "chunk" ? {} : { timeout: mode === "disabled" ? false : mode === "cancel" ? 500 : 70 }),
+          chunkTimeout: mode === "chunk" ? 70 : mode === "cancel" ? 500 : 150,
+        },
+      })
+      const selected = Model.Info.make({
+        ...Model.Info.default(provider.id, Model.ID.make("test")),
+        package: provider.package,
+        headers: { "x-configured": "kept" },
+        body: { custom_extension: { kept: true } },
+        settings: { timeout: 1, chunkTimeout: 1, transport: "websocket" },
+      })
+      const resolver = yield* ModelResolver.Service.pipe(
+        Effect.provide(ModelResolver.layer),
+        Effect.provide(Layer.mock(Provider.Service, { get: () => Effect.succeed(provider) })),
+      )
+      const resolved = yield* resolver.resolveModel(selected)
+      const hooks = yield* PluginHooks.Service
+      yield* hooks.register("session", "model.request", (event) =>
+        Effect.sync(() => {
+          event.headers["x-hook"] = "kept"
+        }),
+      )
+      const requests = yield* SessionModelRequest.Service.pipe(
+        Effect.provide(SessionModelRequest.layer),
+        Effect.provideService(SessionModelTransport.Service, transport),
+      )
+      const prepared = yield* requests.primary({
+        session,
+        agent: Agent.ID.make("build"),
+        model: {
+          ...resolved,
+          // 022 resolves provider timeouts into model defaults; extend, do not replace, that policy.
+          model: LanguageModel.update(resolved.model, {
+            defaults: {
+              ...resolved.model.defaults,
+              http: mergeHttpOptions(resolved.model.defaults?.http, new HttpOptions({ query: { overlay: "kept" } })),
+            },
+          }),
+        },
+        system: [],
+        messages: [Message.user("Hello")],
+        webSocket: "session",
+      })
+      expect(prepared.request.http).toMatchObject({
+        timeout: provider.settings?.timeout,
+        chunkTimeout: provider.settings?.chunkTimeout,
+        query: { overlay: "kept" },
+        body: { custom_extension: { kept: true } },
+        headers: { "x-configured": "kept", "x-hook": "kept", "x-opencode-session-id": session.id },
+      })
+      expect(prepared.options.webSocket).toBeUndefined()
+      expect(prepared.request.providerOptions?.timeout).toBeUndefined()
+      const generate = LLMClient.generate(prepared.request, prepared.options).pipe(Effect.provide(runtime))
+      if (mode === "cancel") {
+        const fiber = yield* Effect.forkChild(generate)
+        yield* Effect.sleep(40)
+        yield* Fiber.interrupt(fiber)
+        const exit = yield* Fiber.await(fiber)
+        expect(exit._tag).toBe("Failure")
+        if (exit._tag === "Failure") expect(Cause.hasInterrupts(exit.cause)).toBe(true)
+      } else {
+        const result = yield* generate.pipe(Effect.result)
+        expect(result._tag).toBe(mode === "disabled" ? "Success" : "Failure")
+        if (result._tag === "Failure")
+          expect(result.failure.reason).toMatchObject({
+            _tag: "Transport",
+            code: "Timeout",
+            operation: "read",
+            http: { status: 200 },
+          })
+      }
+      expect(received?.headers.get("x-hook")).toBe("kept")
+      expect(received?.url).toContain("overlay=kept")
+    }),
+  )
diff --git a/packages/core/test/session-runner-retry-safety.test.ts b/packages/core/test/session-runner-retry-safety.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..df23576cc4d08298743d2f97119219e7cfd34c8a
--- /dev/null
+++ b/packages/core/test/session-runner-retry-safety.test.ts
@@ -0,0 +1,90 @@
+import { expect, test } from "bun:test"
+import {
+  AIError,
+  AuthenticationError,
+  ContentPolicyError,
+  HttpContext,
+  InvalidRequestError,
+  RateLimitError,
+  TransportError,
+} from "@opencode/ai"
+import { SessionRunnerRetry } from "@opencode/core/session/runner/retry"
+import { Session } from "@opencode/core/session"
+import { Agent } from "@opencode/core/agent"
+import { Model } from "@opencode/core/model"
+import { Provider } from "@opencode/core/provider"
+import { Effect } from "effect"
+
+for (const reason of [
+  new AuthenticationError({ message: "Denied" }),
+  new ContentPolicyError({ message: "Denied" }),
+  new InvalidRequestError({ message: "Invalid" }),
+]) {
+  test(`${reason._tag} cannot be made retryable by a positive header or plugin`, async () => {
+    const cause = new AIError({
+      reason: Object.assign(reason, {
+        http: HttpContext.make({ url: "https://example.test", status: 400, headers: { "x-should-retry": "true" } }),
+      }),
+    })
+    expect(SessionRunnerRetry.isRetryable(cause)).toBe(false)
+    const decide = await Effect.runPromise(SessionRunnerRetry.policy(Session.ID.create()))
+    const result = await Effect.runPromise(
+      decide({
+        cause,
+        error: { type: "provider.invalid-request", message: cause.message },
+        agent: Agent.defaultID,
+        model: { id: Model.ID.make("test"), providerID: Provider.ID.opencode },
+        retry: false,
+        hook: (event) =>
+          Effect.sync(() => {
+            event.decision = { retry: true, delay: 0 }
+          }),
+      }),
+    )
+    expect(result).toEqual({ retry: false })
+  })
+}
+
+test("the upstream timeout retry cap cannot be overridden by a plugin", async () => {
+  const decide = await Effect.runPromise(SessionRunnerRetry.policy(Session.ID.create()))
+  const results = []
+  for (const _ of [1, 2, 3, 4]) {
+    results.push(
+      await Effect.runPromise(
+        decide({
+          cause: new AIError({
+            reason: new TransportError({ message: "Timeout", code: "Timeout", transport: "http", operation: "read" }),
+          }),
+          error: { type: "provider.transport", message: "Timeout" },
+          agent: Agent.defaultID,
+          model: { id: Model.ID.make("test"), providerID: Provider.ID.opencode },
+          retry: true,
+          hook: (event) =>
+            Effect.sync(() => {
+              event.decision = { retry: true, delay: 0 }
+            }),
+        }),
+      ),
+    )
+  }
+  expect(results.map((result) => result.retry)).toEqual([true, true, true, false])
+})
+
+test("an explicit negative retry decision cannot be overridden by a plugin", async () => {
+  const decide = await Effect.runPromise(SessionRunnerRetry.policy(Session.ID.create()))
+  expect(
+    await Effect.runPromise(
+      decide({
+        cause: new AIError({ reason: new RateLimitError({ message: "Busy" }) }),
+        error: { type: "provider.rate-limit", message: "Busy" },
+        agent: Agent.defaultID,
+        model: { id: Model.ID.make("test"), providerID: Provider.ID.opencode },
+        retry: false,
+        hook: (event) =>
+          Effect.sync(() => {
+            event.decision = { retry: true, delay: 0 }
+          }),
+      }),
+    ),
+  ).toEqual({ retry: false })
+})
