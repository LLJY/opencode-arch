+            jsonrpc: "2.0",
+            id: body.id,
+            result: {
+              protocolVersion: LATEST_PROTOCOL_VERSION,
+              capabilities: {},
+              serverInfo: { name: "static-auth-debug", version: "1.0.0" },
+            },
+          },
+          { headers: { "Mcp-Session-Id": crypto.randomUUID() } },
+        )
+      },
+    })
+    return {
+      requests,
+      url: http.url,
+      close: () => http.stop(true),
+    }
+  }),
