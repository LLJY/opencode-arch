FROM --platform=$TARGETPLATFORM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4

USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
      binutils \
      ca-certificates \
      dpkg-dev \
      file \
      git \
      patch \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /pkg /build/work /out \
    && chown -R bun:bun /pkg /build /out

COPY --chown=bun:bun . /pkg

USER bun
WORKDIR /build
ENV OUT_DIR=/out
ENV WORK_DIR=/build/work
CMD ["/pkg/build-deb"]
