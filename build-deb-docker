#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
pkgver=$(awk -F= '/^pkgver=/{ print $2; exit }' "$repo_root/PKGBUILD")
pkgrel=$(awk -F= '/^pkgrel=/{ print $2; exit }' "$repo_root/PKGBUILD")
out_dir=${OUT_DIR:-$repo_root/dist/debian-final-$pkgver-$pkgrel}
target=${1:-all}
version=$pkgver-$pkgrel

case "$target" in
  all) arches=(amd64 arm64) ;;
  amd64) arches=(amd64) ;;
  arm64) arches=(arm64) ;;
  *)
    printf 'Usage: %s [all|amd64|arm64]\n' "${0##*/}" >&2
    exit 64
    ;;
esac

mkdir -p "$out_dir"
out_dir=$(cd -- "$out_dir" && pwd)
expected=()
for deb_arch in "${arches[@]}"; do
  expected+=("$out_dir/opencode_${version}_${deb_arch}.deb")
  if [ "$deb_arch" = amd64 ]; then
    expected+=("$out_dir/opencode-daemon_${version}_all.deb")
  fi
done
for file in "${expected[@]}"; do
  if [ -e "$file" ]; then
    printf 'Refusing to reuse existing package output: %s\n' "$file" >&2
    exit 73
  fi
done

built=()
for deb_arch in "${arches[@]}"; do
  build_daemon=$([ "$deb_arch" = amd64 ] && printf 1 || printf 0)
  image="opencode-deb:${version}-${deb_arch}-$$"
  container="opencode-deb-${version}-${deb_arch}-$$"
  package="opencode_${version}_${deb_arch}.deb"

  docker build \
    --platform linux/amd64 \
    --build-arg "DEB_ARCH=$deb_arch" \
    --file "$repo_root/Dockerfile.debian" \
    --tag "$image" \
    "$repo_root"
  docker create \
    --platform linux/amd64 \
    --name "$container" \
    --env "DEB_ARCH=$deb_arch" \
    --env "BUILD_DAEMON=$build_daemon" \
    "$image" >/dev/null
  cleanup() { docker rm -f "$container" >/dev/null 2>&1 || true; }
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  docker start --attach "$container"
  docker cp "$container:/out/$package" "$out_dir/$package"
  [ -s "$out_dir/$package" ]
  docker run --rm \
    --platform linux/amd64 \
    --network none \
    --volume "$out_dir:/export:ro" \
    --entrypoint /bin/bash \
    "$image" \
    /pkg/validate-deb "/export/$package" opencode "$version" "$deb_arch" \
    usr/bin/opencode \
    usr/share/bash-completion/completions/opencode \
    usr/share/zsh/vendor-completions/_opencode \
    usr/share/licenses/opencode/LICENSE
  built+=("$out_dir/$package")

  if [ "$build_daemon" -eq 1 ]; then
    daemon="opencode-daemon_${version}_all.deb"
    docker cp "$container:/out/$daemon" "$out_dir/$daemon"
    [ -s "$out_dir/$daemon" ]
    docker run --rm \
      --platform linux/amd64 \
      --network none \
      --volume "$out_dir:/export:ro" \
      --entrypoint /bin/bash \
      "$image" \
      /pkg/validate-deb "/export/$daemon" opencode-daemon "$version" all \
      - \
      usr/bin/opencode-daemon \
      usr/bin/ocd \
      usr/lib/systemd/user/opencode-daemon.service \
      usr/share/licenses/opencode-daemon/LICENSE
    built+=("$out_dir/$daemon")
  fi

  cleanup
  trap - EXIT INT TERM
done

printf 'Built and validated Debian packages:\n'
printf '  %s\n' "${built[@]}"
